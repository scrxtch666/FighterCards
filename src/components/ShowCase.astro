---
const { showCase } = Astro.props;
import { Image } from "astro:assets";
---

<div
  class="w-1/2 bg-customGray flex p-4 gap-5 rounded-2xl
         font-mono text-xs h-52
         shadow-gold
         hover:shadow-gold-hover
         transition-shadow duration-300"
>
  <div class="flex w-48">
    <Image src={showCase.image} alt="" class="h-auto w-full rounded-2xl" />
  </div>
  <div class="w-full flex flex-col justify-between">
    <div class="flex flex-col">
      <span>{showCase.name}</span>
      <span class="text-customGold">{showCase.belt} belt</span>
    </div>
    <div class="flex justify-between">
      <div class="font-mono">
        {showCase.age}
        <br />
        <span class="text-customGold">Age</span>
      </div>
      <div class="weight">
        {showCase.weight} kg <br />
        <span class="text-customGold">Weight</span>
      </div>
      <div class="height">
        {showCase.height} cm <br />
        <span class="text-customGold">Height</span>
      </div>
    </div>
    <div class="bio">
      <article>{showCase.bio}</article>
    </div>
  </div>
</div>
