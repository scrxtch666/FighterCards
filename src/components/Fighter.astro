---
const { fighterData } = Astro.props;
import { Image } from "astro:assets";
---

<div
  data-fighter-card
  data-fighter-name={fighterData.name}
  class="bg-customGray flex p-4 gap-5 rounded-2xl font-mono text-xs h-52 shadow-pink hover:shadow-pink-hover transition-shadow duration-300 cursor-pointer"
>
  <div class="flex w-48">
    <Image
      src={fighterData.image}
      alt={fighterData.name}
      class="h-auto w-full rounded-2xl"
    />
  </div>
  <div class="w-full flex flex-col">
    <div class="flex flex-col h-full">
      <span>{fighterData.name}</span>
      <span class="text-pink-600">{fighterData.belt} belt</span>
    </div>
    <div class="flex justify-between h-full">
      <div class="font-mono">
        {fighterData.age}
        <br />
        <span class="text-pink-600">Age</span>
      </div>
      <div class="weight">
        {fighterData.weight} kg <br />
        <span class="text-pink-600">Weight</span>
      </div>
      <div class="height">
        {fighterData.height} cm <br />
        <span class="text-pink-600">Height</span>
      </div>
    </div>
    <div class="bio h-full overflow-hidden text-ellipsis"><article>{fighterData.bio}</article></div>
  </div>
</div>

<script src="../../server/public/img.js"></script>