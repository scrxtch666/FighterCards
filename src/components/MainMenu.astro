---
import { Image } from "astro:assets";
const { showCase } = Astro.props;
import minus from "../assets/minus.png";
import plus from "../assets/plus.png";
import retype from "../assets/retype.png";
---

<div
  class="w-full h-20 flex bg-customGray items-center rounded-2xl justify-between p-4 text-customWhite"
>
  <div><a href="/">FighterCards</a></div>
  <div class="flex gap-8">
    <a href="../action/AddFighter"
      ><Image src={plus} alt="" class="w-4 h-4" /></a
    >
    <a href="../action/DeleteFighter"
      ><Image src={minus} alt="" class="w-4 h-4" /></a
    >
    <a href="../action/AllStats"
      ><Image src={retype} alt="" class="w-4 h-4" /></a
    >
  </div>
</div>
